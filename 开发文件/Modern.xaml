<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="归位 · 本地整理助手" Width="1440" Height="920" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#282B3F">
 <Window.Resources>
  <SolidColorBrush x:Key="Purple" Color="#7861FF"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#656B82"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7861FF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#EEEBFF"/><Setter Property="Foreground" Value="#7861FF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,11"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#E9EAF3" BorderThickness="1"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="0"/><TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="#A2A6BA" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#969BB0"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="500"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Width" Value="190"/><Setter Property="Height" Value="274"/><Setter Property="Margin" Value="0,0,17,18"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="card" Background="White" CornerRadius="20" BorderBrush="Transparent" BorderThickness="2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#9683FF"/><Setter TargetName="card" Property="Background" Value="#F9F7FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#C9BFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F5F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#ECEEF6" BorderThickness="0,0,1,0">
   <Grid Margin="20,28,18,22"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#7861FF" CornerRadius="17" VerticalAlignment="Top"><TextBlock Text="归" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,2,0,0"><TextBlock Text="归位" FontSize="23" FontWeight="Bold"/><TextBlock Text="Local Organizer" Foreground="#959BB2" FontSize="12" Margin="0,2,0,0"/></StackPanel></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="工作空间" Style="{StaticResource Caption}" Margin="13,0,0,12"/>
     <Button x:Name="CurrentButton" Style="{StaticResource Soft}" HorizontalContentAlignment="Left" Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock x:Name="CurrentNavText" Text="当前来源"/></StackPanel></Button>
     <Button x:Name="BrowseLibraryButton" HorizontalContentAlignment="Left" Margin="0,0,0,7" ToolTip="查看资料库，保留上次来源目录"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" Margin="0,0,12,0"/><TextBlock Text="查看资料库"/></StackPanel></Button><Button x:Name="QueueButton" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" Margin="0,0,12,0"/><TextBlock x:Name="QueueNavText" Text="待移动清单"/></StackPanel></Button>
     <Grid Margin="13,14,0,12"><TextBlock Text="快捷来源" Style="{StaticResource Caption}"/><Button x:Name="ManageSourcesButton" Content="编辑" FontSize="11" Padding="0" HorizontalAlignment="Right" Margin="0,0,8,0"/></Grid>
     <StackPanel x:Name="FavoritesPanel"/>
     <Button x:Name="FavoriteButton" Content="＋  收藏当前来源" Style="{StaticResource Soft}" Margin="0,8,0,18"/>
     <TextBlock Text="分类框架 · 筛选右侧分类" Style="{StaticResource Caption}" Margin="13,8,0,12"/>
     <StackPanel x:Name="GroupsPanel"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Background="#F8F8FE" CornerRadius="18" BorderBrush="#ECECF7" BorderThickness="1" Padding="15" Margin="0,18,0,0"><StackPanel><TextBlock Text="资料库 · 保存在本机" Style="{StaticResource Caption}"/><TextBlock x:Name="LibraryPath" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,9,0,12"/><Button x:Name="LibraryButton" Content="选择 / 新建资料库" Style="{StaticResource Soft}" Margin="0" Padding="7,11"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,28,25,18"><Grid.RowDefinitions><RowDefinition Height="79"/><RowDefinition Height="57"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="整理文件" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="CountLabel" Text="选择来源，开始整理" Foreground="#9399AF" Margin="0,5,0,0"/></StackPanel>
    <TextBox x:Name="FileSearch" Tag="搜索当前目录的文件名…" Grid.Column="1" Margin="8,4,16,19" ToolTip="搜索当前目录的文件名"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0"><Button x:Name="SourceButton" Content="选择来源" Padding="17,13"/><Button x:Name="RefreshButton" Content="↻" FontSize="20" Padding="15,8" Style="{StaticResource Soft}" ToolTip="刷新当前目录"/><Button x:Name="PreviewButton" Content="预览并移动" Padding="20,13" Style="{StaticResource Primary}" Margin="0"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="UpButton" Content="↑" FontSize="19" Padding="13,6" VerticalAlignment="Top" ToolTip="上一级"/><TextBox x:Name="Address" Grid.Column="1" Margin="0,0,12,12" FontSize="12" Padding="12,8"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ExplorerButton" Content="资源管理器" Style="{StaticResource Soft}" Padding="12,8" ToolTip="在 Windows 文件资源管理器打开当前查看的目录，无需选择文件"/><Button x:Name="RenameButton" Content="整理命名" Style="{StaticResource Soft}" IsEnabled="False" FontSize="12" Padding="12,8" ToolTip="未选中项目时自动识别当前列表中的疑似乱码；选中项目时整理所选名称"/><Button x:Name="ToolbarDeleteButton" Content="删除所选" IsEnabled="False" Background="#FFF4F5" Foreground="#AD5666" Padding="12,8" Margin="0" ToolTip="查看清单，确认后移到回收站"/></StackPanel></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="360"/></Grid.ColumnDefinitions>
    <Grid x:Name="CardsViewport" Margin="0,0,8,0" ClipToBounds="True">
     <ListBox x:Name="Cards" FontFamily="Microsoft YaHei UI" Foreground="#282B3F" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="0,2,0,0"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border CornerRadius="14" Background="{Binding TileColor}" ClipToBounds="True"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{Binding IconData}" Stroke="{Binding Accent}" StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform" Width="49" Height="42" HorizontalAlignment="Center"/><TextBlock Text="{Binding Kind}" Foreground="{Binding Accent}" FontSize="10" Margin="0,14,0,0" HorizontalAlignment="Center"/></StackPanel><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,172,166" RadiusX="13" RadiusY="13"/></Image.Clip></Image><Border Background="#F4FFFFFF" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,4" Margin="8"><TextBlock Text="{Binding SelectionBadge}" FontWeight="Bold" Foreground="#7861FF" FontSize="11"/></Border></Grid></Border>
       <StackPanel Grid.Row="1" Margin="5,9,5,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#9A9FB3" Margin="0,5,0,0"/><TextBlock Text="{Binding Assignment}" Foreground="#7861FF" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="#C9C1EE" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="这里还没有文件" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" HorizontalAlignment="Center"/><TextBlock Text="选择一个来源目录，开始为文件分类。" Foreground="#969BB0"/></StackPanel>
     <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False"><Border x:Name="Marquee" Background="#257861FF" BorderBrush="#9683FF" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"/></Canvas>
    </Grid>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E3DFF3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整文件区与归类区的宽度"/>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="18" Padding="15,12" Margin="0,0,0,12"><Expander x:Name="DetailsExpander" Header="所选项目详情" FontSize="12" Foreground="#767D95"><StackPanel Margin="4,10,4,0"><TextBlock x:Name="DetailName" Text="选择文件或文件夹" FontSize="14" TextWrapping="Wrap" MaxHeight="50"/><TextBlock x:Name="DetailInfo" Text="点击卡片查看信息，框选后可批量标注。" Foreground="#969BB0" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/><UniformGrid Columns="3" Margin="0,12,0,0"><Button x:Name="OpenButton" Content="打开" Style="{StaticResource Soft}" IsEnabled="False" ToolTip="使用系统默认应用打开所选项目"/><Button x:Name="OpenFolderButton" Content="打开文件夹" Style="{StaticResource Soft}" IsEnabled="False" ToolTip="打开所选文件夹或文件所在目录，并置顶资源管理器窗口"/><Button x:Name="DeleteButton" Content="删除" Background="#FFF4F5" Foreground="#AD5666" IsEnabled="False" Margin="0" ToolTip="先预览，再确认移到系统回收站"/></UniformGrid></StackPanel></Expander></Border>
     <Border Grid.Row="1" Background="White" CornerRadius="23" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="4,0,0,13"><TextBlock Text="一键归类" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="CategoryHint" Text="单击标注 · 右键设置简称和置顶" Foreground="#969BB0" FontSize="11" Margin="0,6,0,0"/></StackPanel>
      <TextBox x:Name="CategorySearch" Tag="搜索分类或简称，如：截图、日本…" Grid.Row="1" Background="#F7F7FC" Padding="11,9" Margin="0,0,0,12" ToolTip="搜索分类框架、已展开的目录或显示简称"/>
      <Border x:Name="PinSection" Grid.Row="2" Background="#F7F5FF" CornerRadius="13" Padding="10" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel><TextBlock Text="★  高频置顶" Foreground="#7861FF" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="PinnedPanel"/></ScrollViewer></StackPanel></Border>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CategoryPanel"/></ScrollViewer>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="CategoryPreferencesButton" Content="简称 / 置顶" Style="{StaticResource Soft}" FontSize="11" Padding="12,9"/><Button x:Name="EditCategoriesButton" Content="编辑框架" FontSize="11" Padding="12,9"/><Button x:Name="RefreshCategoryFoldersButton" Content="刷新目录" FontSize="11" Padding="12,9" ToolTip="重新读取资料库中手动创建的文件夹"/><Button x:Name="CreateFrameworkButton" Content="建齐空目录" FontSize="11" Padding="12,9" Margin="0"/></StackPanel>
     </Grid></Border>
    </Grid>
   </Grid>
   <Grid Grid.Row="3" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="所有更改先标注，确认后才移动。" Foreground="#767D95" FontSize="12"/><TextBlock x:Name="Toast" Foreground="#7861FF" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UnmarkButton" Content="取消所选标注" FontSize="12" Padding="13,9"/><Button x:Name="ClearButton" Content="清空清单" FontSize="12" Padding="13,9" Margin="0"/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
